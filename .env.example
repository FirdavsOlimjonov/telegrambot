# ─── Telegram ──────────────────────────────────────────────────────────────────
BOT_TOKEN=7123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_WEBHOOK_URL=                    # Leave empty for polling (dev), set for prod

# ─── Admin Configuration ───────────────────────────────────────────────────────
ADMIN_IDS=123456789,987654321       # Comma-separated Telegram user IDs

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mehnat_bot
POSTGRES_USER=mehnat_user
POSTGRES_PASSWORD=strong_password_here

# Constructed automatically from the above — you can override directly:
# DATABASE_URL=postgresql+asyncpg://mehnat_user:password@localhost:5432/mehnat_bot

# ─── App Settings ──────────────────────────────────────────────────────────────
APP_ENV=development                  # development | staging | production
DEBUG=true
LOG_LEVEL=DEBUG                      # DEBUG | INFO | WARNING | ERROR

# ─── Pagination ────────────────────────────────────────────────────────────────
PAGE_SIZE=5                          # Results per page

# ─── File Upload ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads/                  # Relative path for downloaded Excel files

# ─── Localization ──────────────────────────────────────────────────────────────
DEFAULT_LANGUAGE=uz                  # uz | ru | en
